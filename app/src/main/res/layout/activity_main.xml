<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="66dp" />

    <!-- Bottom Navigation — Replit-style pill bar -->
    <LinearLayout
        android:id="@+id/bottom_navigation_custom"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:orientation="horizontal"
        android:background="@color/bg_bottom_nav"
        android:layout_gravity="bottom"
        android:elevation="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Chat -->
        <LinearLayout
            android:id="@+id/nav_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_chat_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_agent"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/nav_chat_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_chat"
                android:textSize="10sp"
                android:maxLines="1"
                android:layout_marginTop="3dp"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- Dosyalar -->
        <LinearLayout
            android:id="@+id/nav_files"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_files_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_files"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/nav_files_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_files"
                android:textSize="10sp"
                android:maxLines="1"
                android:layout_marginTop="3dp"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- Terminal -->
        <LinearLayout
            android:id="@+id/nav_shell"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_shell_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_shell"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/nav_shell_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_shell"
                android:textSize="10sp"
                android:maxLines="1"
                android:layout_marginTop="3dp"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- AI Market -->
        <LinearLayout
            android:id="@+id/nav_market"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_market_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_market"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/nav_market_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_market"
                android:textSize="10sp"
                android:maxLines="1"
                android:layout_marginTop="3dp"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- Secrets -->
        <LinearLayout
            android:id="@+id/nav_secrets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_secrets_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_secrets"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/nav_secrets_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_secrets"
                android:textSize="10sp"
                android:maxLines="1"
                android:layout_marginTop="3dp"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- Agents -->
        <LinearLayout
            android:id="@+id/nav_agents"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_agents_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_agent2"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/nav_agents_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_agents"
                android:textSize="10sp"
                android:maxLines="1"
                android:layout_marginTop="3dp"
                android:letterSpacing="0.02" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
