<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dim background — tap to dismiss -->
    <View
        android:id="@+id/dismissArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dim_background" />

    <!-- Bottom sheet drawer card -->
    <FrameLayout
        android:id="@+id/bottomDrawerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_sheet_background"
        android:elevation="16dp">

        <!-- Drag handle -->
        <LinearLayout
            android:id="@+id/drawerHeader"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="@color/bg_secondary"
            android:orientation="vertical">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="#444C5E"
                android:layout_gravity="center"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code-ioPRO"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_gravity="center"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Chat WebView -->
        <WebView
            android:id="@+id/drawerWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="40dp" />

    </FrameLayout>

</FrameLayout>
