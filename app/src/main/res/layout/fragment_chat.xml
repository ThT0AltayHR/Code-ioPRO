<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="@color/bg_secondary"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <!-- App Logo + Title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Code-ioPRO"
            android:textColor="@color/accent"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- Settings button -->
        <ImageButton
            android:id="@+id/btn_chat_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_nav_secrets"
            android:tint="@color/text_secondary"
            android:contentDescription="Ayarlar"
            android:padding="10dp" />

    </LinearLayout>

    <!-- Chat Mode Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/bg_secondary"
        android:scrollbars="none"
        android:fadingEdgeLength="0dp">

        <LinearLayout
            android:id="@+id/chat_mode_tabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical"
            android:divider="@null">

            <!-- Voice -->
            <TextView
                android:id="@+id/tab_voice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🎙️ Sesli"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tab_unselected"
                android:clickable="true"
                android:focusable="true" />

            <!-- Daily Chat -->
            <TextView
                android:id="@+id/tab_chat"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="💬 Sohbet"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tab_selected"
                android:clickable="true"
                android:focusable="true" />

            <!-- Code -->
            <TextView
                android:id="@+id/tab_code"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="💻 Kod"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tab_unselected"
                android:clickable="true"
                android:focusable="true" />

            <!-- AI Assistant -->
            <TextView
                android:id="@+id/tab_ai"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🧠 AI"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/tab_unselected"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Loading bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/bg_secondary"
        android:visibility="gone"
        android:max="100" />

    <!-- Chat WebView -->
    <WebView
        android:id="@+id/chatWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
